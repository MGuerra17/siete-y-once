---
// Sunset over the sea with two dice showing 3 + 4 = 7, echoing the app icon. Decorative only.
---

<div class="scene" aria-hidden="true">
  <svg viewBox="0 0 400 400">
    <defs>
      <clipPath id="disc"><circle cx="200" cy="200" r="190"></circle></clipPath>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#F2694B"></stop>
        <stop offset="1" stop-color="#F6B93B"></stop>
      </linearGradient>
    </defs>
    <g clip-path="url(#disc)">
      <rect width="400" height="400" fill="url(#sky)"></rect>
      <circle cx="200" cy="196" r="78" fill="#F3E3C3" opacity=".92"></circle>
      <rect y="196" width="400" height="204" fill="#135E5A"></rect>
      <g fill="#F3E3C3" opacity=".35">
        <rect x="132" y="210" width="136" height="5" rx="2.5"></rect>
        <rect x="152" y="226" width="96" height="4" rx="2"></rect>
        <rect x="172" y="240" width="56" height="3" rx="1.5"></rect>
      </g>
      <rect y="268" width="400" height="132" fill="#0D3B3E"></rect>
      <ellipse cx="200" cy="352" rx="150" ry="16" fill="#092C2E" opacity=".7"></ellipse>
    </g>
    <g class="die" transform="rotate(-12 148 300)">
      <g class="drop">
        <rect x="98" y="250" width="100" height="100" rx="22" fill="#F3E3C3"></rect>
        <g fill="#0D3B3E">
          <circle cx="122" cy="274" r="9"></circle>
          <circle cx="148" cy="300" r="9"></circle>
          <circle cx="174" cy="326" r="9"></circle>
        </g>
      </g>
    </g>
    <g class="die" transform="rotate(9 258 296)">
      <g class="drop late">
        <rect x="208" y="246" width="100" height="100" rx="22" fill="#F3E3C3"></rect>
        <g fill="#F2694B">
          <circle cx="234" cy="272" r="9"></circle>
          <circle cx="282" cy="272" r="9"></circle>
          <circle cx="234" cy="320" r="9"></circle>
          <circle cx="282" cy="320" r="9"></circle>
        </g>
      </g>
    </g>
    <circle cx="200" cy="200" r="190" fill="none" stroke="#F3E3C3" stroke-opacity=".18" stroke-width="2"
    ></circle>
  </svg>
</div>

<style>
  .scene {
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .drop {
      transform-box: fill-box;
      transform-origin: center;
      animation: land 0.9s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
    }
    .late {
      animation-delay: 0.12s;
    }
    @keyframes land {
      from {
        transform: translateY(-40px) rotate(-30deg);
      }
    }
  }
</style>
