---
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource-variable/figtree";
import "../styles/global.css";
import { site } from "../config";
import { routes, t, type Lang, type PageId } from "../i18n";

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
}

const { lang, page, title } = Astro.props;
const tr = t(lang);
const other: Lang = lang === "es" ? "en" : "es";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0D3B3E" />
    <title>{title}</title>
    <meta name="description" content={tr("meta.description")} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href={routes.es[page]} />
    <link rel="alternate" hreflang="en" href={routes.en[page]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={tr("meta.description")} />
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="brand" href={routes[lang].home}>
          <img src="/favicon.svg" alt="" width="34" height="34" />
          <span>{site.appName}</span>
        </a>
        <nav>
          <a href={routes[lang].privacy} aria-current={page === "privacy" ? "page" : undefined}>
            {tr("nav.privacy")}
          </a>
          <a href={routes[lang].support} aria-current={page === "support" ? "page" : undefined}>
            {tr("nav.support")}
          </a>
          <a class="lang" href={routes[other][page]} hreflang={other} lang={other}>
            {tr("nav.switchLang")}
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <span>© {year} {site.developer} · {tr("footer.madeIn")}</span>
        <nav>
          <a href={routes[lang].privacy}>{tr("nav.privacy")}</a>
          <a href={routes[lang].support}>{tr("nav.support")}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 18px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--arena);
    font: 700 18px var(--display);
  }
  .brand img {
    border-radius: 9px;
  }
  header nav {
    display: flex;
    align-items: center;
    gap: 18px;
    font-weight: 500;
    font-size: 15px;
  }
  header nav a {
    color: var(--arena);
    text-decoration: none;
    opacity: 0.85;
  }
  header nav a[aria-current="page"] {
    opacity: 1;
    box-shadow: inset 0 -2px var(--coral);
  }
  .lang {
    font-size: 13px;
    border: 1px solid var(--linea);
    border-radius: 999px;
    padding: 3px 12px;
  }
  footer {
    background: var(--mar-hondo);
    font-size: 14px;
    color: var(--arena-suave);
  }
  footer .wrap {
    padding-block: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    justify-content: space-between;
  }
  footer nav {
    display: flex;
    gap: 18px;
  }
  footer a {
    color: var(--arena-suave);
  }
  @media (max-width: 560px) {
    header nav {
      gap: 12px;
      font-size: 14px;
    }
    .brand span {
      display: none;
    }
  }
</style>
